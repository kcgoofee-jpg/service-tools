[Unit]
Description=猫头鹰公益站实时监控（nai-watch.sh：60 秒轮询，事件流进 journal）
Documentation=https://github.com/kcgoofee-jpg/service-tools/blob/main/deploy/ops/README.md
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/service-tools
ExecStart=/bin/bash /opt/service-tools/deploy/ops/nai-watch.sh
Restart=always
RestartSec=10
# 内存上限：监控脚本自己不该拖垮小机器（配合 MemoryMax 让内核先杀它）
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nai-watch

[Install]
WantedBy=multi-user.target
